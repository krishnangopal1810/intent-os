    },
    {
      "from": "local_model_second_pass",
      "to": "unknown_fail_closed",
      "contract": "Unavailable or low-confidence model output falls back to unknown or rules output."
    },
    {
      "from": "deterministic_classifier",
      "to": "aggregate_reports",
      "contract": "Reports consume classifier output, not raw adapters."
    },
    {
      "from": "local_model_second_pass",
      "to": "aggregate_reports",
      "contract": "Reports include model/runtime identifiers and fallback reasons when models run."
    },
    {
      "from": "evaluation_sets",
      "to": "deterministic_classifier",
      "contract": "Rule changes must pass labeled evaluation thresholds."
    },
    {
      "from": "evaluation_sets",
      "to": "local_model_second_pass",
      "contract": "Model-backed changes add labeled examples and deterministic CI fakes."
    },
    {
      "from": "aggregate_reports",
      "to": "daily_narratives",
      "contract": "Narratives are generated from report artifacts."
    },
    {
      "from": "aggregate_reports",
