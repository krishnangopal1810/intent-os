      "contract": "Only privacy-filtered records enter the shared event boundary."
    },
    {
      "from": "evidence_provenance",
      "to": "activity_event_boundary",
      "contract": "Events carry enough source context for confidence and reason reporting."
    },
    {
      "from": "activity_event_boundary",
      "to": "sessionization",
      "contract": "Session merging operates on normalized ActivityEvent rows."
    },
    {
      "from": "sessionization",
