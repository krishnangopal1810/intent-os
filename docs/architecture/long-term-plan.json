{
  "schema_version": 1,
  "name": "IntentOS Long-Term Architecture Plan",
  "purpose": "Machine-readable roadmap graph for docs, harness checks, and future execution plans.",
  "status_terms": {
    "current": "Implemented and covered by make verify.",
    "next": "Active or recommended next implementation slice.",
    "planned": "Specified with harness contracts, not yet implemented.",
    "future": "Long-term product direction that needs a scoped plan before code."
  },
  "phases": [
    {
      "id": "phase_0_current_foundation",
      "label": "Current foundation",
      "status": "current",
      "capability": "Fixture-backed classification, metadata capture, session timeline, and local UI.",
      "harness_gates": [
        "make verify",
        "make validate-ui",
        "make observe-live",
        "make observe-session"
      ]
    },
    {
      "id": "phase_1_manual_import",
      "label": "Historical local data",
      "status": "next",
      "capability": "Manual CSV/JSON import into ActivityEvent.",
      "harness_gates": [
        "import fixtures",
        "import-validation.json",
        "structured runtime events",
        "product verify smoke command"
      ]
    },
    {
      "id": "phase_2_richer_history",
      "label": "Richer historical context",
      "status": "planned",
      "capability": "Browser history import and ChatGPT export parsing.",
      "harness_gates": [
        "copied or exported local fixtures",
        "privacy exclusion tests",
        "parser validation artifacts",
        "replay artifacts"
      ]
    },
    {
      "id": "phase_3_behavior_intelligence",
      "label": "Behavior intelligence",
      "status": "planned",
      "capability": "Daily narratives, intent mismatch, recurring patterns, and anomalies.",
      "harness_gates": [
        "deterministic narrative fixtures",
        "daily-narrative-summary.json",
        "UI validation evidence"
      ]
    },
    {
      "id": "phase_4_fallbacks_and_models",
      "label": "Harder live gaps",
      "status": "planned",
      "capability": "ScreenCaptureKit fallback, Vision OCR fallback, and local model second pass.",
      "harness_gates": [
        "fallback frame fixtures",
        "OCR fixtures",
        "fake or tiny model path in CI",
        "permission diagnostics",
        "fallback reasons"
      ]
    },
    {
      "id": "phase_5_control_plane",
      "label": "Control plane",
      "status": "future",
      "capability": "Blocking, scheduling, workflow automation, and explicit user-approved actions.",
      "harness_gates": [
        "dry-run fixtures",
        "action audit logs",
        "rollback behavior",
        "interactive UI validation"
      ]
    }
  ],
  "layers": [
    {
      "id": "sources",
      "label": "Capture and Import Sources",
      "contract": "Read local user data through the narrowest available surface and emit bounded observations or records."
    },
    {
      "id": "policy",
      "label": "Local Policy and Evidence Controls",
      "contract": "Apply permissions, pause state, privacy exclusions, redaction, retention, and evidence provenance before persisted artifacts exist."
    },
    {
      "id": "event_pipeline",
      "label": "Event Boundary and Local Storage",
      "contract": "Normalize every source into ActivityEvent, merge adjacent equivalent activity above adapters, and persist replayable local artifacts."
    },
    {
      "id": "inference",
      "label": "Classification and Inference",
      "contract": "Keep deterministic rules as the inspectable baseline; use local models only as optional second-pass classifiers."
    },
    {
      "id": "intelligence",
      "label": "Behavior Intelligence",
      "contract": "Build narratives, mismatch detection, recurring patterns, and anomalies from classified report artifacts."
    },
    {
      "id": "surfaces",
      "label": "Product Surfaces",
      "contract": "Expose behavior, evidence, confidence, and operational state through CLI, UI, diagnostics, and future action controls."
    },
    {
      "id": "harness",
      "label": "Harness and Verification",
      "contract": "Keep every shipped slice runnable, inspectable, fixture-backed, documented, and covered by deterministic checks."
    }
  ],
